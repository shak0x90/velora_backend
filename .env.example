# Copy to .env and adjust. .env is gitignored — never commit real values.

# development | production
VELORA_ENV=development
PORT=8080
LOG_LEVEL=debug

# Local Postgres from deploy/docker-compose.yml.
# In production point this at managed Postgres and keep sslmode=require.
DATABASE_URL=postgres://velora:velora@localhost:5432/velora?sslmode=disable

# Required in production, optional in development so a fresh clone starts.
# Generate with: openssl rand -base64 32
TOKEN_SIGNING_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Comma-separated. The web client dev server runs on :3000.
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth client IDs accepted as the ID token's `aud` claim — one each for
# web, Android, and iOS, comma-separated. These are NOT secrets; they ship
# inside the client apps. No client *secret* is needed: we verify an ID token
# the client already holds rather than exchanging an authorization code.
# Create them at console.cloud.google.com -> APIs & Services -> Credentials.
# Sign-in refuses every request while this is empty.
GOOGLE_CLIENT_IDS=

# Optional browser push. Configure the same values in serve and work.
# Leave empty to keep chat working without external notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional AI practice chat: a clearly labelled AI conversation partner people
# can warm up with while nobody is around for a blind chat. A file holding the
# OpenAI API key (keep it out of the environment and git); empty switches it off.
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-4o-mini

# Optional native push (Android/iOS). Configure the same values in serve and
# work. All empty: devices still register, nothing is sent.
# FCM HTTP v1 — a service-account JSON key with the Firebase Messaging role.
# Covers Android, and iOS too when the app uses firebase_messaging.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# Direct APNs (.p8 token auth). Set all four or none; when set, iOS devices
# go to APNs instead of FCM, so only do this if the app registers raw APNs
# tokens. APNS_TOPIC is the bundle id; APNS_PRODUCTION=false uses the sandbox.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRODUCTION=false

# Google-only sign-in; false is only for legacy development/API fixtures.
GOOGLE_ONLY_AUTH=true
